# All variables below are required - Load() fails fast if any are unset.

PORT=8080

# Single origin of the deployed frontend (e.g. https://waste-dashboard.choreoapps.dev).
# Use * only for local development - never in a deployed environment.
FRONTEND_ORIGIN=*

# OAuth2 credentials for a Google Cloud "OAuth client ID" (Web application type),
# plus a refresh token obtained once via Google's OAuth Playground
# (https://developers.google.com/oauthplayground) using the
# https://www.googleapis.com/auth/spreadsheets.readonly scope, authorized with
# whichever Google account has access to the sheet.
GOOGLE_OAUTH_CLIENT_ID=<add-your-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<add-your-oauth-client-secret>
GOOGLE_OAUTH_REFRESH_TOKEN=<add-your-oauth-refresh-token>

GOOGLE_SHEET_ID=<add-your-sheet-id>
GOOGLE_SHEET_RANGE=Sheet1!A2:H

# How long fetched rows are cached before re-querying the Sheets API
CACHE_TTL_SECONDS=3600
